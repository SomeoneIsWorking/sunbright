.brand {
    font-family: "Fira Sans Condensed";
    font-size: 42dp;
    font-weight: bold;
    color: #C2A42D;
    padding-bottom: 12dp;
}

.detail-heading {
    font-family: "Fira Sans Condensed";
    font-size: 18dp;
    font-weight: bold;
    text-transform: uppercase;
    color: rgba(224, 219, 200, 50%);
    padding-top: 8dp;
}

.detail { font-size: 18dp; color: #E0DBC8; }

.saved,
.escape-hint {
    text-align: center;
    font-size: 15dp;
    color: rgba(224, 219, 200, 55%);
}

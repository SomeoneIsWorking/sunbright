#!/usr/bin/env bash
# gp — interactive game-probe + differential render harness for the Sunbright PC port.
#
# Drives RUNNING game instance(s) headlessly over the HTTP probe REPL (runtime/probe_server.cpp):
# send inputs, screenshot, read render/guest state — no GUI, no relaunch between actions.
#
# TWO roles can run CONCURRENTLY for live render A/B (oracle vs native):
#   ngx  : the native PC renderer (SUNBRIGHT_NGX_PRESENT), probe port 17654
#   gx   : the recomp Dolphin-GX render of the SAME recomp game logic (NGX_PRESENT=0) = the render
#          ORACLE, probe port 17655, isolated Dolphin user dir (scratch/oracle_userdir).
# `pad`/`shot`/`compare` fan out to ALL running instances, so you drive both in lockstep and
# diff their frames live.
#
# Session:
#   tools/gp launch both            # boot ngx (17654) AND gx-oracle (17655), detached
#   tools/gp pad start 200          # press Start on BOTH (skip THP/FMV + advance menus in lockstep)
#   tools/gp compare title          # screenshot both -> title.ngx.png / title.gx.png + diff report
#   tools/gp ngx                    # native-renderer stats (/ngxshape) on the ngx instance
#   tools/gp gx drawstats           # run a command against the gx-oracle instance
#   tools/gp kill                   # stop all
#
# Single instance is fine too: `tools/gp launch` (ngx only) then pad/shot/ngx.
# Skip the THP/intro movie by pressing Start (pad start), NOT fastboot (that jumps to gameplay
# and skips the title-logo/file-select where the native renderer's bugs show).
#
# ⚠ This tool + the /probe skill are a LIVING system — EXPAND them as needed (new endpoints, new
#   compare modes, more instances). The end goal is a Dolphin-free port; until then the gx oracle
#   is how we make the native renderer faithful. Keep tools/gp and .claude/commands/probe.md in sync.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="${SUNBRIGHT_BIN:-$HERE/build/sunbright}"   # current single build dir (build-j3dvirt was the retired flip branch)
NGX_PORT=17654; GX_PORT=17655
SHOTS="$HERE/scratch/screenshots"

porturl() { echo "http://127.0.0.1:$1"; }
q() { curl -s --max-time "${GP_TIMEOUT:-8}" "$(porturl "$1")$2"; }              # q <port> <path>
up() { curl -s --max-time 2 "$(porturl "$1")/ngxshape" >/dev/null 2>&1; }       # up <port>
# echo the ports of all running instances
active() { for p in $NGX_PORT $GX_PORT; do up "$p" && echo "$p"; done; }
role_of() { [ "$1" = "$GX_PORT" ] && echo gx || echo ngx; }

launch_one() {  # launch_one <role> [extra VAR=val ...]
    local role="$1"; shift
    [ -f "$HERE/.env" ] && { set -a; . "$HERE/.env"; set +a; }
    local ROM="${SUNBRIGHT_ROM:-$HERE/rom.rvz}"
    [ -x "$BIN" ] || { echo "no binary: $BIN"; return 1; }
    [ -f "$ROM" ] || { echo "no ROM: $ROM"; return 1; }
    mkdir -p "$HERE/scratch/logs" "$SHOTS"
    local -a E=(SUNBRIGHT_HEADLESS=1 SUNBRIGHT_PROBE=1)
    local port log
    if [ "$role" = gx ]; then
        port=$GX_PORT; log="$HERE/scratch/logs/gp.gx.log"
        # PURE-Dolphin LIVE oracle: NGX_PRESENT=0 AND no NGX_SHAPE — the J3D capture path
        # BYPASSES Dolphin's GX render (freezes its XFB on an early frame), so the oracle must
        # NOT enable capture. Isolated user dir so its shader cache/config don't clash with ngx.
        E+=(SUNBRIGHT_NGX_PRESENT=0 SUNBRIGHT_PROBE_PORT=$GX_PORT SUNBRIGHT_USERDIR="$HERE/scratch/oracle_userdir")
    else
        port=$NGX_PORT; log="$HERE/scratch/logs/gp.ngx.log"
        E+=(SUNBRIGHT_NGX_SHAPE=1 SUNBRIGHT_NGX_PRESENT=1 SUNBRIGHT_PROBE_PORT=$NGX_PORT)
    fi
    # Kill any prior instance holding this probe port (else the stale one keeps answering).
    { fuser -k "${port}/tcp" 2>/dev/null || lsof -ti "tcp:${port}" 2>/dev/null | xargs -r kill -9; } ; sleep 1
    setsid env "${E[@]}" "$@" "$BIN" "$ROM" >"$log" 2>&1 < /dev/null &
    echo "[$role] launched pid $! (port $port, log: ${log#$HERE/}) — waiting…"
    for i in $(seq 1 40); do sleep 2; if up "$port"; then echo "[$role] probe up (~$((i*2))s)"; return 0; fi; done
    echo "[$role] probe DID NOT come up in 80s"; tail -5 "$log"; return 1
}

brightness() { source "$HERE/scratch/venv/bin/activate" 2>/dev/null || true
    python3 - "$@" <<'PY' 2>/dev/null || true
import sys,numpy as np
from PIL import Image
for f in sys.argv[1:]:
    try: a=np.asarray(Image.open(f).convert("RGB")).astype(float)
    except Exception as e: print(f"  {f}: BAD {e}"); continue
    print(f"  {f.split('/')[-1]:22s} {a.shape[1]}x{a.shape[0]} meanRGB={a.reshape(-1,3).mean(0).round(0)} med={np.median(a.reshape(-1,3).mean(1)):.0f}")
PY
}
diffimg() {  # diffimg <a.png> <b.png> <out.png>
    source "$HERE/scratch/venv/bin/activate" 2>/dev/null || true
    python3 - "$1" "$2" "$3" <<'PY' 2>/dev/null || true
import sys,numpy as np
from PIL import Image
a=Image.open(sys.argv[1]).convert("RGB"); b=Image.open(sys.argv[2]).convert("RGB")
if a.size!=b.size: b=b.resize(a.size)
A=np.asarray(a).astype(float); B=np.asarray(b).astype(float)
mad=np.abs(A-B).mean()
# stacked side-by-side for visual inspection
out=np.concatenate([np.asarray(a),np.asarray(b)],axis=1)
Image.fromarray(out).save(sys.argv[3])
print(f"  meanAbsDiff={mad:.1f}  side-by-side -> {sys.argv[3].split('/')[-1]} (left=ngx, right=gx)")
PY
}

# Poll the ngx instance until the native renderer has captured a real 3D scene
# (frame_swaps >= target). Returns 0 when reached, 1 on timeout. waitscene [target] [maxsecs]
waitscene() {
    local target="${1:-60}" maxs="${2:-160}" p="${GP_ONLY:-$NGX_PORT}"
    for i in $(seq 1 $((maxs/2))); do
        local fs; fs=$(q "$p" /ngxshape 2>/dev/null | grep -o 'frame_swaps=[0-9]*' | head -1)
        fs=${fs#frame_swaps=}; [ -n "$fs" ] && [ "$fs" -ge "$target" ] 2>/dev/null && { echo "[ngx] 3D scene reached (frame_swaps=$fs, ~$((i*2))s)"; return 0; }
        sleep 2
    done
    echo "[ngx] TIMEOUT waiting for frame_swaps>=$target"; return 1
}
# Poll until the gameplay HUD is drawing (hud_quads>0 in /ngxpresentlive) — a robust "reached
# real gameplay" signal (coin/shine counters), unlike a raw frame_swaps count which lands on a
# nondeterministic title/transition frame. waitgameplay [maxsecs]
waitgameplay() {
    local maxs="${1:-200}" p="${GP_ONLY:-$NGX_PORT}"
    for i in $(seq 1 $((maxs/2))); do
        local hq; hq=$(q "$p" /ngxpresentlive 2>/dev/null | grep -o 'hud_quads=[0-9]*' | head -1)
        hq=${hq#hud_quads=}; [ -n "$hq" ] && [ "$hq" -gt 0 ] 2>/dev/null && { echo "[ngx] gameplay HUD up (hud_quads=$hq, ~$((i*2))s)"; return 0; }
        sleep 2
    done
    echo "[ngx] TIMEOUT waiting for gameplay HUD"; return 1
}
# Run the per-region pixel-delta number on the latest abshot2 PPMs (the real fidelity metric).
abdiff() { python3 "$HERE/tools/render/ab_diff.py" "$SHOTS/ab2.gx.ppm" "$SHOTS/ab2.ngx.ppm" 2>&1 | head -8; }

cmd="${1:-help}"; shift || true
case "$cmd" in

scene)    # ONE-SHOT: kill stale -> launch ngx headless -> reach the scene -> freeze the aligned
          # GX-vs-ngx A/B -> abshot2 -> per-region delta. Extra args = launch ENV.
          #   gp scene                          # FASTBOOT to Delfino-plaza GAMEPLAY (DETERMINISTIC, reliable)
          #   gp scene TITLE                    # AUTOSTART, freeze at the title logo (multi-matrix logo case)
          #   gp scene SUNBRIGHT_NGX_TEVDBG=ras # pass debug env through
          # gameplay uses FASTBOOT (straight into File 1 Delfino Plaza) — same spawn every run, so it's
          # the reproducible A/B. AUTOSTART is unreliable (stalls at file-select). SUNBRIGHT_STATE save-
          # load is KNOWN-BROKEN on the native path (see main_sdl.cpp).
    mode=gameplay; rest=()
    for a in "$@"; do case "$a" in
        TITLE) mode=title;;
        SWAPS=*) mode="swaps:${a#SWAPS=}";;
        *) rest+=("$a");;
    esac; done
    pkill -x sunbright 2>/dev/null; sleep 1
    case "$mode" in
        gameplay) launch_one ngx SUNBRIGHT_FASTBOOT=1 "${rest[@]}" || exit 1
                  waitgameplay 200 || { echo "(gameplay HUD not reached — check scratch/logs/gp.ngx.log)"; exit 1; };;
        title)    launch_one ngx SUNBRIGHT_AUTOSTART=1 "${rest[@]}" || exit 1; waitscene 60 || exit 1;;
        swaps:*)  launch_one ngx SUNBRIGHT_AUTOSTART=1 "${rest[@]}" || exit 1; waitscene "${mode#swaps:}" 240 || exit 1;;
    esac
    echo "[freeze] $(q "$NGX_PORT" '/ngxfreeze?on=1')"
    echo "[abshot2] $(q "$NGX_PORT" /abshot2)"; abdiff
    ;;

wait)     waitscene "${1:-60}" "${2:-160}";;
freeze)   q "${GP_ONLY:-$NGX_PORT}" "/ngxfreeze?on=${1:-1}";;        # 1=latch aligned A/B, 0=release
only)     q "${GP_ONLY:-$NGX_PORT}" "/ngxonly?ti=${1:--1}";;          # render ONLY this tev_index (-1 off)
skip)     q "${GP_ONLY:-$NGX_PORT}" "/ngxskip?ti=${1:--1}";;          # SKIP this tev_index (-1 off)
noblend)  q "${GP_ONLY:-$NGX_PORT}" "/ngxnoblend?on=${1:--1}";;       # 0=force opaque, -1=per-material
pixbatch) q "${GP_ONLY:-$NGX_PORT}" "/pixbatch?x=${1:?usage: gp pixbatch <ndcx> <ndcy>}&y=${2:?need y}";;
ab2)      echo "$(q "$NGX_PORT" /abshot2)"; abdiff;;                  # re-capture frozen A/B + delta
png)      for r in gx ngx; do magick "$SHOTS/ab2.$r.ppm" "$SHOTS/ab2.$r.png" 2>/dev/null && echo "ab2.$r.png"; done;;

launch)
    what="${1:-ngx}"; [ $# -gt 0 ] && shift || true
    case "$what" in
        both) pkill -x sunbright 2>/dev/null; sleep 1; launch_one ngx "$@"; launch_one gx "$@";;
        gx)   launch_one gx "$@";;
        ngx)  launch_one ngx "$@";;
        *)    pkill -x sunbright 2>/dev/null; sleep 1; launch_one ngx "$what" "$@";;   # treat as env
    esac
    ;;

pad)   # fan out to ALL running instances (lockstep drive)
    combo="${1:?usage: gp pad <combo> [ms]}"; ms="${2:-200}"
    for p in $(active); do echo "[$(role_of $p)] $(q "$p" "/pad?do=$combo&ms=$ms")"; done
    ;;

shot|compare)   # screenshot every running instance: <name>.<role>.png ; diff if 2
    name="${1:-shot}"; declare -a files=()
    for p in $(active); do r=$(role_of "$p"); q "$p" "/screenshot?name=$name.$r" >/dev/null
        f="$SHOTS/$name.$r.png"; [ -f "$f" ] && files+=("$f"); done
    [ ${#files[@]} -gt 0 ] && brightness "${files[@]}"
    [ ${#files[@]} -eq 2 ] && diffimg "$SHOTS/$name.ngx.png" "$SHOTS/$name.gx.png" "$SHOTS/$name.diff.png"
    ;;

abshot)   # ZERO-DRIFT single-process A/B: toggles the present source in the ngx instance to
          # dump Dolphin's GX render AND the native render for the SAME frame -> <name>.gx.png
          # + <name>.ngx.png + diff. No oracle process, no fastboot/shader-cache drift. Launch
          # the ngx instance with debug env to isolate a stage, e.g.:
          #   gp launch ngx SUNBRIGHT_FASTBOOT=1 SUNBRIGHT_DBG_RASCOLOR=1 SUNBRIGHT_NGX_TEVDBG=ras
          #   gp abshot lit_iso     # both pngs are lit-raster -> pure lighting A/B
    name="${1:-ab}"; echo "$(q "$NGX_PORT" "/abshot?name=$name")"
    g="$SHOTS/$name.gx.png"; nn="$SHOTS/$name.ngx.png"
    [ -f "$g" ] && [ -f "$nn" ] && { brightness "$nn" "$g"; diffimg "$nn" "$g" "$SHOTS/$name.diff.png"; }
    ;;

abshot2)  # TRUE zero-drift A/B: same-present dual capture (Dolphin GX XFB + native ngx) -> PPM.
          # Pixel-perfect camera alignment (no temporal drift). Requires the ngx instance in
          # NGX_PRESENT mode. Same debug-env usage as abshot for stage isolation.
    name="${1:-ab2}"; echo "$(q "$NGX_PORT" "/abshot2")"
    g="$SHOTS/ab2.gx.ppm"; nn="$SHOTS/ab2.ngx.ppm"
    [ -f "$g" ] && [ -f "$nn" ] && { brightness "$nn" "$g"; diffimg "$nn" "$g" "$SHOTS/$name.diff.png"; }
    ;;

gx)    # run a subcommand against the gx-oracle port: gp gx <ngx|drawstats|r ...|get /path|shot ..>
    GP_ONLY=$GX_PORT exec "${BASH_SOURCE[0]}" "$@"
    ;;

dbg)      q "${GP_ONLY:-$NGX_PORT}" "/ngxdbg?m=${1:-normal}";;   # flip ngx debug mode LIVE: normal|tex|ras|cat|bid
xf)       q "${GP_ONLY:-$NGX_PORT}" "/xfdump";;   # live Dolphin xfmem lighting/colour (use on gx oracle for truth)
xfhist)   q "${GP_ONLY:-$NGX_PORT}" "/xfhist";;   # distinct xfmem (cc,amb,light0) tuples at J3DShape::draw (oracle=truth)
ngx)      q "${GP_ONLY:-$NGX_PORT}" "/ngxshape";;
present)  q "${GP_ONLY:-$NGX_PORT}" "/ngxpresentlive";;
metrics)  q "${GP_ONLY:-$NGX_PORT}" "/metrics";;
drawstats) q "${GP_ONLY:-$NGX_PORT}" "/drawstats";;
r)        q "${GP_ONLY:-$NGX_PORT}" "/r?a=${1:?usage: gp r <hex> [n]}&n=${2:-8}";;
fn)       q "${GP_ONLY:-$NGX_PORT}" "/fn?a=${1:?usage: gp fn <hex>}";;
get)      q "${GP_ONLY:-$NGX_PORT}" "${1:?usage: gp get </path>}";;
help2)    q "${GP_ONLY:-$NGX_PORT}" "/help";;

status)   for p in $NGX_PORT $GX_PORT; do up "$p" && echo "$(role_of $p): up (port $p)" || echo "$(role_of $p): down"; done;;
kill)     pkill -x sunbright 2>/dev/null && echo killed || echo "not running";;

*)  sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    echo; echo "ONE-SHOT:  gp scene [SWAPS=N] [ENV=v..]   # launch->wait 3D scene->freeze->A/B delta"
    echo "commands: launch [ngx|gx|both] [ENV=v..] | scene | wait [swaps] | pad <combo> [ms] |"
    echo "          freeze [0|1] | only <ti> | skip <ti> | noblend [0|-1] | pixbatch <x> <y> |"
    echo "          ab2 | png | shot|compare [name] | abshot2 [name] | dbg <mode> |"
    echo "          gx <subcmd> | ngx | present | metrics | drawstats | r <hex> [n] | fn <hex> |"
    echo "          get </path> | help2 | status | kill";;
esac

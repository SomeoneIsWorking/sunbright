#!/usr/bin/env bash
# gp — interactive game-probe + differential render harness for the Sunbright PC port.
#
# Drives RUNNING game instance(s) headlessly over the HTTP probe REPL (runtime/probe_server.cpp):
# send inputs, screenshot, read render/guest state — no GUI, no relaunch between actions.
#
# TWO roles can run CONCURRENTLY for live render A/B (oracle vs native):
#   ngx  : the native PC renderer (SUNBRIGHT_NGX_PRESENT), probe port 17654
#   gx   : the recomp Dolphin-GX render of the SAME recomp game logic (NGX_PRESENT=0) = the render
#          ORACLE, probe port 17655, isolated Dolphin user dir (scratch/oracle_userdir).
# `pad`/`shot`/`compare` fan out to ALL running instances, so you drive both in lockstep and
# diff their frames live.
#
# Session:
#   tools/gp launch both            # boot ngx (17654) AND gx-oracle (17655), detached
#   tools/gp pad start 200          # press Start on BOTH (skip THP/FMV + advance menus in lockstep)
#   tools/gp compare title          # screenshot both -> title.ngx.png / title.gx.png + diff report
#   tools/gp ngx                    # native-renderer stats (/ngxshape) on the ngx instance
#   tools/gp gx drawstats           # run a command against the gx-oracle instance
#   tools/gp kill                   # stop all
#
# Single instance is fine too: `tools/gp launch` (ngx only) then pad/shot/ngx.
# Skip the THP/intro movie by pressing Start (pad start), NOT fastboot (that jumps to gameplay
# and skips the title-logo/file-select where the native renderer's bugs show).
#
# ⚠ This tool + the /probe skill are a LIVING system — EXPAND them as needed (new endpoints, new
#   compare modes, more instances). The end goal is a Dolphin-free port; until then the gx oracle
#   is how we make the native renderer faithful. Keep tools/gp and .claude/commands/probe.md in sync.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="${SUNBRIGHT_BIN:-$HERE/build-j3dvirt/sunbright}"
NGX_PORT=17654; GX_PORT=17655
SHOTS="$HERE/scratch/screenshots"

porturl() { echo "http://127.0.0.1:$1"; }
q() { curl -s --max-time "${GP_TIMEOUT:-8}" "$(porturl "$1")$2"; }              # q <port> <path>
up() { curl -s --max-time 2 "$(porturl "$1")/ngxshape" >/dev/null 2>&1; }       # up <port>
# echo the ports of all running instances
active() { for p in $NGX_PORT $GX_PORT; do up "$p" && echo "$p"; done; }
role_of() { [ "$1" = "$GX_PORT" ] && echo gx || echo ngx; }

launch_one() {  # launch_one <role> [extra VAR=val ...]
    local role="$1"; shift
    [ -f "$HERE/.env" ] && { set -a; . "$HERE/.env"; set +a; }
    local ROM="${SUNBRIGHT_ROM:-$HERE/rom.rvz}"
    [ -x "$BIN" ] || { echo "no binary: $BIN"; return 1; }
    [ -f "$ROM" ] || { echo "no ROM: $ROM"; return 1; }
    mkdir -p "$HERE/scratch/logs" "$SHOTS"
    local -a E=(SUNBRIGHT_HEADLESS=1 SUNBRIGHT_NGX_SHAPE=1 SUNBRIGHT_PROBE=1)
    local port log
    if [ "$role" = gx ]; then
        port=$GX_PORT; log="$HERE/scratch/logs/gp.gx.log"
        E+=(SUNBRIGHT_NGX_PRESENT=0 SUNBRIGHT_PROBE_PORT=$GX_PORT SUNBRIGHT_USERDIR="$HERE/scratch/oracle_userdir")
    else
        port=$NGX_PORT; log="$HERE/scratch/logs/gp.ngx.log"
        E+=(SUNBRIGHT_NGX_PRESENT=1 SUNBRIGHT_PROBE_PORT=$NGX_PORT)
    fi
    # Kill any prior instance holding this probe port (else the stale one keeps answering).
    { fuser -k "${port}/tcp" 2>/dev/null || lsof -ti "tcp:${port}" 2>/dev/null | xargs -r kill -9; } ; sleep 1
    setsid env "${E[@]}" "$@" "$BIN" "$ROM" >"$log" 2>&1 < /dev/null &
    echo "[$role] launched pid $! (port $port, log: ${log#$HERE/}) — waiting…"
    for i in $(seq 1 40); do sleep 2; if up "$port"; then echo "[$role] probe up (~$((i*2))s)"; return 0; fi; done
    echo "[$role] probe DID NOT come up in 80s"; tail -5 "$log"; return 1
}

brightness() { source "$HERE/scratch/venv/bin/activate" 2>/dev/null || true
    python3 - "$@" <<'PY' 2>/dev/null || true
import sys,numpy as np
from PIL import Image
for f in sys.argv[1:]:
    try: a=np.asarray(Image.open(f).convert("RGB")).astype(float)
    except Exception as e: print(f"  {f}: BAD {e}"); continue
    print(f"  {f.split('/')[-1]:22s} {a.shape[1]}x{a.shape[0]} meanRGB={a.reshape(-1,3).mean(0).round(0)} med={np.median(a.reshape(-1,3).mean(1)):.0f}")
PY
}
diffimg() {  # diffimg <a.png> <b.png> <out.png>
    source "$HERE/scratch/venv/bin/activate" 2>/dev/null || true
    python3 - "$1" "$2" "$3" <<'PY' 2>/dev/null || true
import sys,numpy as np
from PIL import Image
a=Image.open(sys.argv[1]).convert("RGB"); b=Image.open(sys.argv[2]).convert("RGB")
if a.size!=b.size: b=b.resize(a.size)
A=np.asarray(a).astype(float); B=np.asarray(b).astype(float)
mad=np.abs(A-B).mean()
# stacked side-by-side for visual inspection
out=np.concatenate([np.asarray(a),np.asarray(b)],axis=1)
Image.fromarray(out).save(sys.argv[3])
print(f"  meanAbsDiff={mad:.1f}  side-by-side -> {sys.argv[3].split('/')[-1]} (left=ngx, right=gx)")
PY
}

cmd="${1:-help}"; shift || true
case "$cmd" in

launch)
    what="${1:-ngx}"; [ $# -gt 0 ] && shift || true
    case "$what" in
        both) pkill -x sunbright 2>/dev/null; sleep 1; launch_one ngx "$@"; launch_one gx "$@";;
        gx)   launch_one gx "$@";;
        ngx)  launch_one ngx "$@";;
        *)    pkill -x sunbright 2>/dev/null; sleep 1; launch_one ngx "$what" "$@";;   # treat as env
    esac
    ;;

pad)   # fan out to ALL running instances (lockstep drive)
    combo="${1:?usage: gp pad <combo> [ms]}"; ms="${2:-200}"
    for p in $(active); do echo "[$(role_of $p)] $(q "$p" "/pad?do=$combo&ms=$ms")"; done
    ;;

shot|compare)   # screenshot every running instance: <name>.<role>.png ; diff if 2
    name="${1:-shot}"; declare -a files=()
    for p in $(active); do r=$(role_of "$p"); q "$p" "/screenshot?name=$name.$r" >/dev/null
        f="$SHOTS/$name.$r.png"; [ -f "$f" ] && files+=("$f"); done
    [ ${#files[@]} -gt 0 ] && brightness "${files[@]}"
    [ ${#files[@]} -eq 2 ] && diffimg "$SHOTS/$name.ngx.png" "$SHOTS/$name.gx.png" "$SHOTS/$name.diff.png"
    ;;

gx)    # run a subcommand against the gx-oracle port: gp gx <ngx|drawstats|r ...|get /path|shot ..>
    GP_ONLY=$GX_PORT exec "${BASH_SOURCE[0]}" "$@"
    ;;

ngx)      q "${GP_ONLY:-$NGX_PORT}" "/ngxshape";;
present)  q "${GP_ONLY:-$NGX_PORT}" "/ngxpresentlive";;
metrics)  q "${GP_ONLY:-$NGX_PORT}" "/metrics";;
drawstats) q "${GP_ONLY:-$NGX_PORT}" "/drawstats";;
r)        q "${GP_ONLY:-$NGX_PORT}" "/r?a=${1:?usage: gp r <hex> [n]}&n=${2:-8}";;
fn)       q "${GP_ONLY:-$NGX_PORT}" "/fn?a=${1:?usage: gp fn <hex>}";;
get)      q "${GP_ONLY:-$NGX_PORT}" "${1:?usage: gp get </path>}";;
help2)    q "${GP_ONLY:-$NGX_PORT}" "/help";;

status)   for p in $NGX_PORT $GX_PORT; do up "$p" && echo "$(role_of $p): up (port $p)" || echo "$(role_of $p): down"; done;;
kill)     pkill -x sunbright 2>/dev/null && echo killed || echo "not running";;

*)  sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    echo; echo "commands: launch [ngx|gx|both] [ENV=v..] | pad <combo> [ms] | shot|compare [name] |"
    echo "          gx <subcmd> | ngx | present | metrics | drawstats | r <hex> [n] | fn <hex> |"
    echo "          get </path> | help2 | status | kill";;
esac

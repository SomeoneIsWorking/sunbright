#!/usr/bin/env bash
# Repo pre-commit gate. Tracked (unlike .git/hooks), so it travels with a clone:
#   git config core.hooksPath .githooks
#
# WHAT IT GUARDS. Diagnostic switches rot in a specific, expensive way: a switch named in
# CLAUDE.md, docs/ or a run script that NO code reads sends a session chasing a control that does
# not exist. That has happened here (SB_SKIP_GHOST was cited in the project instructions for a
# while and was never in the source at all), and a stale generated registry hides the drift.
#
# It runs in well under a second and passes clean today, which is the point — a gate that fails on
# day one is a gate people learn to bypass. If it fires, either the mention is a tombstone (delete
# the NAME, do not annotate it) or the switch was never implemented.
set -eo pipefail
REPO="$(git rev-parse --show-toplevel)"

if ! python3 "$REPO/tools/diag_registry.py" check; then
    cat >&2 <<'MSG'

pre-commit: the diagnostic-switch registry is stale or names a switch no code reads.
  fix:   python3 tools/diag_registry.py write     # regenerate docs/diagnostics.md
  or:    python3 tools/diag_registry.py phantoms  # see which names have no reader
  Deliberate always-loud stderr writes are marked with a LOGGER-EXEMPT comment beside the
  print (inside the scanner's window, not above the enclosing block).
MSG
    exit 1
fi
